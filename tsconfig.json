{
  "include": [
    "*.js",
    "*.ts",
    "__tests__/**/*.ts",
    "__fixtures__/**/*.ts",
    "scripts/*.ts",
    "packages/**/*.ts"
  ],
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "incremental": true,
    "noImplicitAny": true,
    "outDir": "dist",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@serlo/authorization": ["./packages/authorization/src"],
      "@serlo/db-migrations": ["./packages/db-migrations"],
      "~/*": ["./packages/server/src/*"]
    }
  },
  "ts-node": {
    "esm": true
  }
}
